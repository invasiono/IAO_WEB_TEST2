# Chọn loại máy chủ gửi mail: 'gmail' (gửi mail thật) hoặc 'mailtrap' (hộp thư ảo test)
SMTP_PROVIDER=gmail

# Cấu hình GMAIL SMTP (Gửi OTP thật đến email người dùng)
# Lấy mật khẩu ứng dụng 16 ký tự tại: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Cấu hình Mailtrap SMTP (Hộp thư ảo thử nghiệm)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=your_mailtrap_username_here
MAILTRAP_PASSWORD=your_mailtrap_password_here

# Flask Secret Key & Port
SECRET_KEY=change-me
PORT=5000

# WebAuthn: use the exact browser origin and its hostname as rpID.
# Production example: WEBAUTHN_ORIGIN=https://login.example.com
#                    WEBAUTHN_RP_ID=login.example.com
WEBAUTHN_ORIGIN=http://localhost:5000
WEBAUTHN_RP_ID=localhost
# Production example (HTTPS required):
# WEBAUTHN_ORIGIN=https://example.com
# WEBAUTHN_RP_ID=example.com
